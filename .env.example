# ==============================================================================
# ChurchSys — environment template
#
# Copy to `.env` and fill in the values:
#     cp .env.example .env && php artisan key:generate
#
# Production values are held by the system owner and are shared out-of-band.
# NEVER commit a real `.env`.
# ==============================================================================

APP_NAME=ChurchSys
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ChurchSys stores and displays Hong Kong local time. See config/app.php.
APP_TIMEZONE=Asia/Hong_Kong
APP_LOCALE=zh_HK
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_HK

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Database
#
# Local Docker Compose:   DB_HOST=mysql        (the compose service name)
# Local `artisan serve`:  DB_HOST=127.0.0.1    (mysql port is published there)
# Production:             DB_HOST=mysql        (inside the compose network)
#
# The production database was migrated from the legacy MySQL 5.7 Yii system.
# It is utf8mb4. Do NOT change DB_CHARSET/DB_COLLATION.
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=churchsys
DB_USERNAME=churchsys
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ------------------------------------------------------------------------------
# Session / cache / queue
#
# These are file-backed on purpose: file sessions avoid a DB round-trip on
# every request, and the application has no queued work.
# ------------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=null

CACHE_STORE=file
QUEUE_CONNECTION=sync

# ------------------------------------------------------------------------------
# Filesystem
#
# Member photos live in `public/storage/file/`. On the production server that
# path is an s3fs mount of the S3 bucket below (read-only), so uploads written
# from the admin UI only persist if S3 is mounted read-write.
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=true

# ------------------------------------------------------------------------------
# Mail (not used yet — all mail currently goes to the log)
# ------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_FROM_ADDRESS="noreply@cmals.org"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
