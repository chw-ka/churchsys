# ============================================================
# ChurchSys — repository .gitignore
# ============================================================

# ---------- Laravel ----------
/vendor
/node_modules
/public/build
/public/hot
/public/fonts-manifest.dev.json
/public/storage
/storage/*.key
/storage/pail
/bootstrap/cache/*.php
/database/*.sqlite
/database/*.sqlite-journal
_ide_helper.php
_ide_helper_models.php

# ---------- Environment / secrets ----------
# Never commit real credentials. The production .env is shared out-of-band.
.env
.env.*
!.env.example
/auth.json
Homestead.json
Homestead.yaml

# Private keys and certificates. TLS material is provisioned on the server by
# certbot (see deploy/certbot/) and must never be committed.
*.pem
*.key
*.crt
!deploy/nginx/ssl/.gitkeep

# ---------- Tooling / editors ----------
.phpactor.json
.phpunit.result.cache
.phpunit.cache/
/.idea
/.vscode
/.nova
/.zed
/.cursor
/.codex
/.fleet
.claude/settings.local.json
.DS_Store
Thumbs.db
*.log

# ---------- Local working artifacts (not part of the application) ----------
# Agent scratch space, local database dumps, infrastructure backups, UI captures.
.workbuddy/
backups/
*.sql
*.sql.gz
*.tar
*.tar.gz
*.dump
/.lightsail/
/churchsys2-from-server/
/PRODUCTION_SERVER.md
/UPGRADE_PLAN.md
/production_schema.sql
/*.png

# ---------- Re-included deployment assets ----------
!deploy/sql/*.sql
